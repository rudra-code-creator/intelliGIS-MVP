# AI Provider — set one of the options below in .env.local

# Recommended: NVIDIA NIM (free developer tier)
# Get your key at https://build.nvidia.com/settings
AI_PROVIDER=nvidia
NVIDIA_API_KEY=PASTE-HERE
NVIDIA_MODEL=z-ai/glm-5.2

# Alternative: OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4.1-mini

# Force mock data (no API calls)
# AI_PROVIDER=mock
